---
import { SITE, HERO } from "../data/site";

// 把 *包裹* 的文字解析成主题色强调：用代码，解决*真实的问题*。
const parts = HERO.headline.split("*");
---

<section class="hero" id="top">
  <div class="wrap">
    <p class="mono-label kicker">{HERO.kicker}</p>

    <h1 class="headline">
      {parts.map((seg, i) =>
        i % 2 === 1 ? <span class="em">{seg}</span> : <span>{seg}</span>
      )}
    </h1>

    <p class="echo">{HERO.echo}</p>

    <p class="sub">{HERO.sub}</p>

    <div class="ctas">
      <a href="#projects" class="btn btn-solid">看看做过的项目 ↓</a>
      <a href="#contact" class="btn btn-ghost">联系我</a>
    </div>

    <dl class="stats">
      {HERO.stats.map((s) => (
        <div class="stat">
          <dt class="mono-label">{s.k}</dt>
          <dd class="v">{s.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(64px, 9vw, 120px) clamp(48px, 6vw, 80px);
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
  }

  .hero .wrap {
    width: 100%;
  }

  .kicker {
    margin-bottom: 20px;
  }

  .headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 7.2vw, 88px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
    max-width: 18em;
  }

  .em {
    color: var(--accent);
  }

  .echo {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 2.6vw, 30px);
    color: var(--muted);
    margin-top: 10px;
  }

  .sub {
    max-width: 34em;
    margin-top: 24px;
    font-size: clamp(15px, 1.6vw, 18px);
    color: var(--muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: clamp(40px, 6vw, 72px);
  }

  .stat {
    background: var(--bg);
    padding: 22px 24px;
  }

  .v {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 30px);
    letter-spacing: -0.01em;
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
