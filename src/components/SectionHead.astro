---
// 分区标题：大号描边编号 + 中文标题 + 英文等宽小字 + 可选引言
interface Props {
  no: string;
  title: string;
  titleEn: string;
  intro?: string;
}

const { no, title, titleEn, intro } = Astro.props;
---

<div class="sec-head">
  <span class="no" aria-hidden="true">{no}</span>
  <div class="t">
    <h2>{title}</h2>
    <p class="mono-label">{titleEn}</p>
  </div>
  {intro && <p class="intro">{intro}</p>}
</div>

<style>
  .sec-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 8px 20px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .no {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 84px);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-strong);
    user-select: none;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .t .mono-label {
    margin-top: 8px;
  }

  .intro {
    grid-column: 1 / -1;
    max-width: 36em;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  @media (min-width: 900px) {
    .sec-head {
      grid-template-columns: auto 1fr minmax(0, 30em);
      align-items: end;
    }

    .intro {
      grid-column: auto;
      justify-self: end;
      text-align: right;
      border-top: none;
      padding-top: 0;
    }
  }
</style>
